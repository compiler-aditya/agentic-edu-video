# Required: OpenRouter key (LLMs, image generation, vision + audio QA)
OPENROUTER_API_KEY=sk-or-v1-...

# Recommended: ElevenLabs key for expressive, conversational narration (one take for the whole lesson).
# Without it the pipeline narrates with free edge-tts voices.
ELEVENLABS_API_KEY=

# Optional overrides
# EDUVIDEO_MODELS=best              # model preset: best (default) or fast
# EDUVIDEO_PLANNER_MODEL=...        # override any single role: PLANNER, WRITER, REVIEWER, VISION, AUDIO, IMAGE
# EDUVIDEO_MAX_COST_USD=4.0        # hard cost ceiling per run
# EDUVIDEO_TTS=auto                 # auto | elevenlabs | edge
# EDUVIDEO_EL_MODEL=eleven_v3       # ElevenLabs model;  EDUVIDEO_EL_SPEED=1.15
# EDUVIDEO_MAX_CONCURRENCY=2       # parallel OpenRouter requests
# EDUVIDEO_FONT=/path/to/font.ttf  # override the caption font (path[:face_index])
